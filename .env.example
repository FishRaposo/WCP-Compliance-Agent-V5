# WCP Compliance Platform V5 - local/mock example only.
# Copy to .env for development. Replace every placeholder before a real deployment;
# never commit a populated .env file. `pnpm evidence` needs none of these values.

# Gateway
JWT_SECRET=dev-only-change-before-deployment
AUTH_DISABLED=true
AGENT_URL=http://localhost:3001
COMPLIANCE_CORE_URL=http://localhost:8000
DATA_PLATFORM_URL=http://localhost:8001

# Agent
LLM_PROVIDER=openai
LLM_MODE=mock
OPENAI_API_KEY=
COMPLIANCE_CORE_URL=http://localhost:8000
DATA_PLATFORM_URL=http://localhost:8001

# Compliance Core
DATA_PLATFORM_URL=http://localhost:8001

# Data Platform
DATABASE_URL=postgresql+asyncpg://wcp:local-only@localhost:5432/wcp_v5
REDIS_URL=redis://localhost:6379
SAM_GOV_API_KEY=
DB_PASSWORD=local-only

# Web
VITE_API_URL=http://localhost:3000
VITE_MOCK_API=true
