# WCP Compliance Platform V5 - Root Environment
# Copy this file to .env and fill in values

# Gateway
JWT_SECRET=dev-secret
AUTH_DISABLED=true
AGENT_URL=http://localhost:3001
COMPLIANCE_CORE_URL=http://localhost:8000
DATA_PLATFORM_URL=http://localhost:8001

# Agent
LLM_PROVIDER=openai
LLM_MODE=mock
OPENAI_API_KEY=
COMPLIANCE_CORE_URL=http://localhost:8000
DATA_PLATFORM_URL=http://localhost:8001

# Compliance Core
DATA_PLATFORM_URL=http://localhost:8001

# Data Platform
DATABASE_URL=postgresql+asyncpg://wcp:wcp_dev_password@localhost:5432/wcp_v5
REDIS_URL=redis://localhost:6379

# Web
VITE_API_URL=http://localhost:3000
VITE_MOCK_API=true
