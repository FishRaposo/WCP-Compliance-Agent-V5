{
  "name": "wcp-compliance-platform-v5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "node --test tests/tooling/portfolio-gates.test.mjs && turbo run test --concurrency=2",
    "test:contracts": "turbo run test:contracts",
    "test:golden": "cd apps/compliance-core && poetry run pytest tests/eval -q",
    "test:gateway:integration": "cd apps/gateway && pnpm test integration",
    "evidence": "pnpm --filter @wcp/agent exec tsx ../../scripts/portfolio_demo.ts && node scripts/verify_portfolio_evidence.mjs artifacts/portfolio/wcp-compliance-agent-v5-evidence --golden tests/fixtures/golden/portfolio-evidence-v2.json",
    "test:e2e": "playwright test",
    "demo:ui": "pnpm --filter @wcp/web demo:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<3.15.2": "3.15.2",
      "ws@<8.21.0": "8.21.0",
      "fast-uri@<3.1.9": "3.1.9",
      "ip-address@<10.7.4": "10.7.4",
      "qs@<6.16.1": "6.16.1",
      "proxy-addr@<2.0.8": "2.0.8",
      "body-parser@<2.4.0": "2.4.0",
      "compression@<1.8.2": "1.8.2",
      "shell-quote@<1.11.0": "1.11.0",
      "protobufjs@<7.6.5": "7.6.5",
      "image-size@<2.0.3": "2.0.3",
      "form-data@<4.0.6": "4.0.6",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "vitest@<3.2.6": "3.2.6",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "@grpc/grpc-js@<1.14.5": "1.14.5",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.0.2": "2.0.2",
      "tinypool@<2.1.2": "2.1.2"
    }
  }
}
