{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PayrollRecord",
  "description": "Individual employee payroll record tied to a contract",
  "type": "object",
  "required": ["employee_name", "trade_code", "week_ending", "hours_worked", "hourly_rate", "gross_pay"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "contract_id": { "type": "string", "format": "uuid" },
    "employee_name": { "type": "string" },
    "trade_code": { "type": "string" },
    "locality_code": { "type": "string" },
    "week_ending": { "type": "string", "format": "date" },
    "hours_worked": { "type": "number" },
    "hourly_rate": { "type": "number" },
    "overtime_hours": { "type": "number", "default": 0 },
    "overtime_rate": { "type": "number" },
    "gross_pay": { "type": "number" },
    "fringe_benefits": { "type": "number", "default": 0 },
    "deductions": { "type": "number", "default": 0 },
    "net_pay": { "type": "number" },
    "source": { "type": "string" },
    "source_reference": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
