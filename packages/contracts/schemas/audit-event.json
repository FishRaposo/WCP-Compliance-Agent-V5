{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditEvent",
  "description": "Immutable audit trail entry for a compliance decision",
  "type": "object",
  "required": ["event_id", "decision_id", "event_type", "timestamp"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "decision_id": { "type": "string" },
    "request_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "artifact_received",
        "extraction_complete",
        "validation_complete",
        "verdict_issued",
        "trust_scored",
        "decision_persisted",
        "human_review_queued",
        "human_review_complete"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": { "type": "string" },
    "payload": { "type": "object" },
    "regulation_references": { "type": "array", "items": { "type": "string" } },
    "trace_id": { "type": "string" },
    "tenant_id": { "type": "string" }
  }
}
