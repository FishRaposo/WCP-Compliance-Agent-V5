{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeterministicReport",
  "description": "Output of the deterministic rule engine for all compliance checks",
  "type": "object",
  "required": ["report_id", "artifact_id", "checks", "overall_status", "violation_count", "warning_count"],
  "properties": {
    "report_id": { "type": "string" },
    "artifact_id": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "check_type", "status"],
        "properties": {
          "check_id": { "type": "string" },
          "check_type": {
            "type": "string",
            "enum": ["wage_rate", "overtime", "fringe_benefit", "signature", "total_arithmetic", "classification", "data_integrity", "minimum_wage"]
          },
          "employee_name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "warning"] },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "expected_value": { "type": "number" },
          "actual_value": { "type": "number" },
          "variance": { "type": "number" },
          "regulation_cite": { "type": "string" },
          "message": { "type": "string" },
          "citation_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "overall_status": { "type": "string", "enum": ["pass", "fail", "warnings"] },
    "violation_count": { "type": "integer" },
    "warning_count": { "type": "integer" },
    "passed_count": { "type": "integer" },
    "confidence_inputs": {
      "type": "object",
      "properties": {
        "extraction_confidence": { "type": "number" },
        "rate_match_confidence": { "type": "number" },
        "rule_coverage": { "type": "number" }
      }
    },
    "dbwd_rates_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trade": { "type": "string" },
          "locality": { "type": "string" },
          "rate": { "type": "number" },
          "fringe": { "type": "number" },
          "effective_date": { "type": "string" }
        }
      }
    }
  }
}
