{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrustScoredDecision",
  "description": "Agent-produced trust-scored decision payload submitted to Data Platform for official persistence",
  "type": "object",
  "required": [
    "job_id",
    "verdict",
    "trust_score",
    "trust_band"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "verdict": { "type": "string", "enum": ["approved", "rejected", "needs_review"] },
    "trust_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "trust_band": { "type": "string", "enum": ["auto_approve", "flag_for_review", "require_human_review"] },
    "requires_human_review": { "type": "boolean" },
    "violation_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "llm_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasoning_summary": { "type": "string" },
    "citations": { "type": "array", "items": { "type": "object" } },
    "cost_usd": { "type": "number" },
    "latency_ms": { "type": "integer" },
    "step_latencies": { "type": "object" },
    "phoenix_trace_id": { "type": "string" },
    "contract_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
