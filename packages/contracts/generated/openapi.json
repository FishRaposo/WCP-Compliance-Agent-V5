{
  "openapi": "3.0.2",
  "paths": {
    "/api/v1/analyze": {
      "post": {
        "summary": "Analyze raw WH-347 payroll text end-to-end and return a trust-scored decision.",
        "tags": [],
        "parameters": [],
        "operationId": "analyze",
        "requestBody": {
          "description": "Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "job_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string"
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "approved",
                        "rejected",
                        "needs_review"
                      ]
                    },
                    "trust_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "trust_band": {
                      "type": "string",
                      "enum": [
                        "auto_approve",
                        "flag_for_review",
                        "require_human_review"
                      ]
                    },
                    "requires_human_review": {
                      "type": "boolean"
                    },
                    "violation_count": {
                      "type": "integer"
                    },
                    "warning_count": {
                      "type": "integer"
                    },
                    "llm_confidence": {
                      "type": "number"
                    },
                    "reasoning_summary": {
                      "type": "string"
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "regulation": {
                            "type": "string"
                          },
                          "section": {
                            "default": "",
                            "type": "string"
                          },
                          "text": {
                            "default": "",
                            "type": "string"
                          }
                        },
                        "required": [
                          "regulation"
                        ]
                      }
                    },
                    "cost_usd": {
                      "type": "number",
                      "nullable": true
                    },
                    "latency_ms": {
                      "type": "integer",
                      "nullable": true
                    },
                    "phoenix_trace_id": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "job_id",
                    "verdict",
                    "trust_score",
                    "trust_band",
                    "requires_human_review",
                    "violation_count",
                    "warning_count",
                    "reasoning_summary",
                    "citations"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "nullable": true
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "502",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "nullable": true
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
